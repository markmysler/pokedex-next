# Copy this file to .env.local and fill in values from your Supabase
# project's dashboard: Project Settings -> API.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret — server-only, never prefix with NEXT_PUBLIC_. Used only in
# app/api/**/route.ts via lib/supabase/serverClient.ts.
SUPABASE_SECRET_KEY=
