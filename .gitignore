# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# supabase CLI local runtime state (created by `npm run db:start` --
# machine-local, not shared config; supabase/config.toml and
# supabase/migrations/ are the only tracked parts of this folder)
supabase/.branches/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
